{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}zabawa z pomiarami{% endblock %}

{% block body %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_measurement_index') }}">pomiary: 360 na okraglo</a></li>
            <li class="breadcrumb-item active" aria-current="page">zmien na prod xD</li>
        </ol>
    </nav>
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card form-card">
                <div class="card-body p-4 p-md-5">
                    <div class="mb-4">
                        <div class="text-uppercase small text-primary fw-semibold mb-2">instrukckja konfiguracji maszyny pogodowej</div>
                        <h1 class="h2 mb-2">zmieniaj</h1>
                        <p class="text-secondary mb-0">wszystko czego dzis chcesz... moze byc twoje kochanie, tu masz, baw sie xoxoxo</p>
                    </div>
                    {{ include('measurement/_form.html.twig', {button_label: 'mamy to!'}) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
