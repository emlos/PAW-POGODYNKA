{{ form_start(form) }}
    <div class="row g-3">
        <div class="col-12">
            {{ form_row(form.location) }}
        </div>
        <div class="col-12 col-md-6">
            {{ form_row(form.date) }}
        </div>
        <div class="col-12 col-md-6">
            {{ form_row(form.celsius) }}
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-4">
        <button class="btn btn-primary">{{ button_label|default('mamy to?') }}</button>
        <a href="{{ path('app_measurement_index') }}" class="btn btn-outline-secondary">nie no czekaj</a>
    </div>
{{ form_end(form) }}
