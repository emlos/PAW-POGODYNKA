{{ form_start(form) }}
    <div class="row g-3">
        <div class="col-12">
            {{ form_row(form.city) }}
        </div>
        <div class="col-12 col-md-6">
            {{ form_row(form.country) }}
        </div>
        <div class="col-12 col-md-6">
            {{ form_row(form.latitude) }}
        </div>
        <div class="col-12 col-md-6">
            {{ form_row(form.longitude) }}
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-4">
        <button class="btn btn-primary">{{ button_label|default('uratuj mnie') }}</button>
        <a href="{{ path('app_location_index') }}" class="btn btn-outline-secondary">LOL okpa</a>
    </div>
{{ form_end(form) }}
