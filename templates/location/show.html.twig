{% extends 'base.html.twig' %}

{% block title %}{{ location.city }}{% endblock %}

{% block body %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_location_index') }}">Cities baby</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ location.city }}</li>
        </ol>
    </nav>
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card detail-card">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                        <div>
                            <div class="text-uppercase small text-primary fw-semibold mb-2">Czego mozna chciec wiecej?</div>
                            <h1 class="h2 mb-1">{{ location.city }}</h1>
                            <p class="text-secondary mb-0">{{ location.country }}</p>
                        </div>
                        <span class="badge rounded-pill text-bg-primary px-3 py-2">Aj Di #{{ location.id }}</span>
                    </div>
                    <dl class="row mb-4">
                        <dt class="col-sm-5 text-secondary">cyfreki szerokosne</dt>
                        <dd class="col-sm-7">{{ location.latitude }}</dd>
                        <dt class="col-sm-5 text-secondary">dlugosci geocyferkowe</dt>
                        <dd class="col-sm-7">{{ location.longitude }}</dd>
                    </dl>
                    <div class="action-stack">
                        <a href="{{ path('app_measurement_index', {location: location.id}) }}" class="btn btn-primary">obczaj wymiary</a>
                        <a href="{{ path('app_location_edit', {id: location.id}) }}" class="btn btn-outline-secondary">manipuluj</a>
                        {{ include('location/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
